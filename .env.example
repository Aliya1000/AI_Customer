# ==============================================================================
# Environment Configuration Template for AI Customer Support Assistant
# Copy this file to .env and configure the credentials for your environment.
# ==============================================================================

# Application & Server Settings
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:8000

# ------------------------------------------------------------------------------
# Supabase Configuration (PostgreSQL Database & Storage Buckets)
# ------------------------------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_or_service_role_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_STORAGE_BUCKET=knowledge-docs
FORCE_MOCK_SUPABASE=false

# ------------------------------------------------------------------------------
# LLM Providers (Multi-Provider Fallback Cascade: Groq -> OpenAI -> Anthropic -> Gemini)
# ------------------------------------------------------------------------------
GROQ_API_KEY=gsk_your_groq_api_key_here
OPENAI_API_KEY=sk-your_openai_api_key_here
ANTHROPIC_API_KEY=sk-ant-your_anthropic_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
LLM_PROVIDER=groq

# ------------------------------------------------------------------------------
# RAG Service & Vector Database (Pinecone Hybrid Search)
# ------------------------------------------------------------------------------
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_ENVIRONMENT=us-east-1
PINECONE_INDEX_NAME=rag-hybrid-search
HYBRID_ALPHA=0.5
TOP_K=5
