# ==============================================================================
# Backend API Environment Configuration Example
# ==============================================================================
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000
APP_NAME="AI Customer Coaching Assistant"
API_PREFIX=/api
LOG_LEVEL=INFO

# Standalone RAG Microservice URL (RAG runs on port 8001)
RAG_SERVICE_URL=http://localhost:8001
RAG_INTERNAL_SECRET=rag-backend-secret-key-2026

# Supabase Credentials
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-or-service-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_STORAGE_BUCKET=knowledge-docs
FORCE_MOCK_SUPABASE=false

# LLM API Keys
GROQ_API_KEY=gsk_...
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GEMINI_API_KEY=AIza...

# Allowed CORS Origins
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:8000,http://localhost:8001
