# Pinecone Configuration
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=rag-hybrid-search
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# NVIDIA Inference Embeddings (e.g. nvidia/nemotron-3.5-embed-1b)
NVIDIA_API_KEY=nvapi-your_nvidia_api_key_here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_EMBEDDING_MODEL=nvidia/nemotron-3.5-embed-1b
EMBEDDING_DIMENSION=1024

# Groq Vision-Language Model (VLM) for Image Parsing (via langchain-groq)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_VLM_MODEL=qwen/qwen3.8-27b
VLM_MAX_TOKENS=1024

# Optional LLM / Fallback
OPENAI_API_KEY=
OPENAI_MODEL_NAME=gpt-4o-mini

# Hybrid Search Parameters
# Alpha: 1.0 = Pure Dense (semantic), 0.0 = Pure Sparse (keyword/BM25), 0.5 = Balanced Hybrid
HYBRID_ALPHA=0.5
TOP_K=5

# Document Chunking
CHUNK_SIZE=800
CHUNK_OVERLAP=150
